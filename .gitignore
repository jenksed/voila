# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Research copies of reference repositories (must never be vendored).
# Anchored to repo root so docs/research/ is NOT ignored.
/research/

# Pi runtime and private state (when Voila runs on Pi)
sessions/
auth.json
trust.json
models-store.json
# Local, machine-specific settings (a committed settings template may override this later)
settings.local.json

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Downloaded/generated binaries
bin/

# Logs and temp files
*.log
*.tmp
*.swp

# OS / editor
.DS_Store
.vscode/
.idea/

# Local canonical-state backups (not tracked)
.voila/backups/

# Receipt staging directories from interrupted verification runs (never committed)
.voila/receipts/.tmp/
